cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# Environment variables / secrets
.env
.env.*

# Personal knowledge/data
data/*
!data/.gitkeep

# Local databases
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local model files
models/
EOF
